    "Captures you save appear here, searchable by file name and by any text Snaplet recognised in them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures you save appear here, searchable by file name and by any text Snaplet recognised in them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğiniz çekimler burada görünür; dosya adına ve Snaplet'in tanıdığı metne göre aranabilir."
          }
        }
      }
    },
    "Captures, edits, OCR and exports all happen on this Mac. Snaplet has no account, no telemetry and makes no network requests.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures, edits, OCR and exports all happen on this Mac. Snaplet has no account, no telemetry and makes no network requests."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekim, düzenleme, metin tanıma ve dışa aktarma bu Mac üzerinde yapılır. Snaplet'te hesap ve telemetri yoktur; hiçbir ağ isteği göndermez."
          }
        }
      }
    },
